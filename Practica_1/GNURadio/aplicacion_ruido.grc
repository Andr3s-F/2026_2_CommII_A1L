- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\nclass blk(gr.sync_block):\n    \"\"\"Bloque de Promedios\
      \ de Tiempo Estad\xEDsticos\"\"\"\n\n    def __init__(self):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Promedios_de_tiempos',\n            in_sig=[np.float32],\n\
      \            out_sig=[np.float32, np.float32, np.float32, np.float32, np.float32]\n\
      \        )\n        self.acum_anterior = 0.0\n        self.Ntotales = 0\n  \
      \      self.acum_anterior1 = 0.0\n        self.acum_anterior2 = 0.0\n\n    def\
      \ work(self, input_items, output_items):\n        x = input_items[0]\n     \
      \   y0 = output_items[0]  # Media\n        y1 = output_items[1]  # Media Cuadr\xE1\
      tica\n        y2 = output_items[2]  # RMS\n        y3 = output_items[3]  # Potencia\
      \ Promedio\n        y4 = output_items[4]  # Desviaci\xF3n Est\xE1ndar\n\n  \
      \      N = len(x)\n        if N > 0:\n            self.Ntotales += N\n\n   \
      \         # 1. Media\n            acumulado = self.acum_anterior + np.cumsum(x)\n\
      \            self.acum_anterior = acumulado[-1]\n            y0[:] = acumulado\
      \ / self.Ntotales\n\n            # 2. Media Cuadr\xE1tica\n            x2 =\
      \ np.multiply(x, x)\n            acumulado1 = self.acum_anterior1 + np.cumsum(x2)\n\
      \            self.acum_anterior1 = acumulado1[-1]  # Correcci\xF3n de variable\
      \ en la gu\xEDa\n            y1[:] = acumulado1 / self.Ntotales\n\n        \
      \    # 3. Valor RMS\n            y2[:] = np.sqrt(y1)\n\n            # 4. Potencia\
      \ Promedio\n            y3[:] = np.multiply(y2, y2)\n\n            # 5. Desviaci\xF3\
      n Est\xE1ndar\n            x3 = np.multiply(x - y0, x - y0)\n            acumulado2\
      \ = self.acum_anterior2 + np.cumsum(x3)\n            self.acum_anterior2 = acumulado2[-1]\n\
      \            y4[:] = np.sqrt(acumulado2 / self.Ntotales)\n\n        return len(x)\n\
      \n\n\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: "('Promedios_de_tiempos', 'blk', [], [('0', 'float', 1)], [('0', 'float',\
      \ 1), ('1', 'float', 1), ('2', 'float', 1), ('3', 'float', 1), ('4', 'float',\
      \ 1)], 'Bloque de Promedios de Tiempo Estad\xEDsticos', [])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [736, 176.0]
    rotation: 0
    state: enabled
