    bus_source: false
    bus_structure: null
    coordinate: [1448, 660.0]
    rotation: 0
    state: enabled
- name: symbol_repeat
  id: blocks_repeat
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    interp: sps
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [632, 304.0]
    rotation: 0
    state: enabled
- name: throttle
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 296.0]
    rotation: 0
    state: enabled

connections:
- [bit_source, '0', nrz_mapper, '0']
- [channel_awgn, '0', fsk_demod_rx, '0']
- [channel_awgn, '0', rx_time, '1']
- [channel_awgn, '0', spectrum_compare, '1']
- [fsk_demod_rx, '0', freq_inst_compare, '1']
- [fsk_demod_tx, '0', freq_inst_compare, '0']
- [fsk_modulator, '0', throttle, '0']
- [nrz_mapper, '0', symbol_repeat, '0']
- [symbol_repeat, '0', fsk_modulator, '0']
- [throttle, '0', channel_awgn, '0']
- [throttle, '0', fsk_demod_tx, '0']
- [throttle, '0', rx_time, '0']
- [throttle, '0', spectrum_compare, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
